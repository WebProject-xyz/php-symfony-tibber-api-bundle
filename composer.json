{
  "name": "webproject-xyz/php-symfony-tibber-api-bundle",
  "description": "A Symfony bundle for the Tibber API client (webproject-xyz/php-tibber-api-client)",
  "license": "MIT",
  "type": "symfony-bundle",
  "authors": [
    {
      "name": "Benjamin Fahl",
      "email": "ben+github@webproject.xyz",
      "role": "developer"
    }
  ],
  "homepage": "https://www.webproject.xyz",
  "require": {
    "php": "~8.5.0",
    "psr/cache": "^3.0",
    "symfony/config": "^8.1.5",
    "symfony/console": "^8.1.7",
    "symfony/dependency-injection": "^8.1.7",
    "symfony/http-kernel": "^8.1.7",
    "webproject-xyz/php-tibber-api-client": "^1.0.1"
  },
  "require-dev": {
    "codeception/codeception": "^5.3.5",
    "codeception/module-asserts": "^3.3.0",
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "phpro/grumphp": "^2.23.0",
    "phpstan/phpstan": "^2.2.14",
    "roave/security-advisories": "dev-latest",
    "webproject-xyz/codeception-module-ai-reporter": "^2.1.0",
    "webproject-xyz/php-cs-fixer-config": "^1.1.3"
  },
  "autoload": {
    "psr-4": {
      "WebProject\\Symfony\\TibberApiBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WebProject\\Symfony\\TibberApiBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "cs:check": "XDEBUG_MODE=off php-cs-fixer fix --allow-risky=yes --dry-run --diff --show-progress=dots",
    "cs:fix": "XDEBUG_MODE=off php-cs-fixer fix --show-progress=none --allow-risky=yes",
    "qa": [
      "@test:build",
      "@cs:fix",
      "@test",
      "@stan"
    ],
    "stan": "XDEBUG_MODE=off phpstan analyse --no-progress --no-ansi --memory-limit=-1",
    "test": "XDEBUG_MODE=off codecept run --report",
    "test:build": "XDEBUG_MODE=off codecept build",
    "test:coverage": "XDEBUG_MODE=coverage codecept run --coverage --coverage-xml=coverage.xml --xml  --report"
  }
}
